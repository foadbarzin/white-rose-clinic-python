# =============================================================================
# White Rose Clinic — نمونهٔ تنظیمات محیطی (غیرمحرمانه)
# کپی کنید به .env و مقادیر را جایگزین کنید. فایل .env هرگز Commit نمی‌شود.
# =============================================================================

# --- اپلیکیشن -----------------------------------------------------------------
APP_NAME="White Rose Clinic"
APP_VERSION="0.5.0"
# development | test | production
APP_ENV="development"
DEBUG="true"

# --- شبکه ---------------------------------------------------------------------
API_HOST="127.0.0.1"
API_PORT="8000"

# --- دیتابیس ------------------------------------------------------------------
# توسعه (SQLite):
DATABASE_URL="sqlite+pysqlite:///./var/wrc-dev.db"
# هدف PostgreSQL (فقط پس از نصب/اجازهٔ مدیر):
# DATABASE_URL="postgresql+psycopg://wrc_app:CHANGE_ME@127.0.0.1:5432/white_rose_clinic"

# --- امنیت --------------------------------------------------------------------
# حداقل ۳۲ نویسه؛ در production مقدار پیش‌فرض/نمونه پذیرفته نمی‌شود.
# با دستور زیر بسازید: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_generate_a_random_48_char_secret_key_before_use"

# طول عمر مطلق نشست (ثانیه) — پیش‌فرض ۸ ساعت
SESSION_TTL="28800"

# --- منطقهٔ زمانی --------------------------------------------------------------
TIMEZONE="Asia/Tehran"
