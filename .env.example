# =============================================================================
# White Rose Clinic — نمونهٔ تنظیمات محیطی (غیرمحرمانه)
# کپی کنید به .env و مقادیر را جایگزین کنید. فایل .env هرگز Commit نمی‌شود.
# =============================================================================

# --- اپلیکیشن -----------------------------------------------------------------
APP_NAME="White Rose Clinic"
APP_VERSION="0.5.0"
# development | test | production
APP_ENV="development"
DEBUG="true"

# --- شبکه ---------------------------------------------------------------------
API_HOST="127.0.0.1"
API_PORT="8000"

# --- دیتابیس ------------------------------------------------------------------
# توسعه (SQLite):
DATABASE_URL="sqlite+pysqlite:///./var/wrc-dev.db"
# هدف PostgreSQL (فقط پس از نصب/اجازهٔ مدیر):
# DATABASE_URL="postgresql+psycopg://wrc_app:CHANGE_ME@127.0.0.1:5432/white_rose_clinic"

# --- امنیت --------------------------------------------------------------------
# حداقل ۳۲ نویسه؛ در production مقدار پیش‌فرض/نمونه پذیرفته نمی‌شود.
# با دستور زیر بسازید: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_generate_a_random_48_char_secret_key_before_use"

# طول عمر مطلق نشست (ثانیه) — تصمیم مدیر: ۱۲ ساعت
SESSION_TTL="43200"
# زمان بی‌کاری نشست (ثانیه) — تصمیم مدیر: ۳۰ دقیقه
SESSION_IDLE_SECONDS="1800"
SESSION_MAX_CONCURRENT="3"

# --- ورود و قفل حساب ------------------------------------------------------------
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"
LOGIN_RATE_LIMIT_PER_MINUTE="10"

# --- Argon2id (مقادیر تولیدی؛ در تست‌ها کاهش می‌یابد) --------------------------
ARGON2_MEMORY_KIB="65536"
ARGON2_TIME_COST="3"
ARGON2_PARALLELISM="4"

# --- CORS (خالی = فقط same-origin؛ نمونهٔ لیست JSON) ---------------------------
CORS_ALLOW_ORIGINS="[]"
# CORS_ALLOW_ORIGINS='["http://127.0.0.1:3000"]'

# --- منطقهٔ زمانی --------------------------------------------------------------
TIMEZONE="Asia/Tehran"
